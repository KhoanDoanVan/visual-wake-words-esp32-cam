# Large/generated ML artifacts
/artifacts/checkpoints/
/artifacts/models/
/artifacts/logs/
/artifacts/figures/
/artifacts/reports/*
!/artifacts/reports/training_metadata.json
!/artifacts/reports/test_metrics.json
!/artifacts/reports/export_info.json
!/artifacts/reports/model_profile_summary.json

# Nested experiment training state. Keep small reports and deployable .tflite files.
/artifacts/**/checkpoints/
/artifacts/**/logs/
/artifacts/**/*.keras
/artifacts/**/*.h5
/artifacts/**/*.ckpt
/artifacts/**/*.ckpt.*
/artifacts/**/saved_model/

# Rejected exploratory candidate; its reproducible configuration remains in configs/.
/artifacts/fast_64/
/artifacts/high_resolution_teacher_160/

# Device-profile source summaries stay versioned; raw firmware and duplicate plots do not.
/artifacts/device_profiles/*/firmware/
/artifacts/device_profiles/*/*.png

